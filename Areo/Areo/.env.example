# Copy to .env and adjust. All values are optional; these are the defaults.

# SQLite by default. For PostgreSQL: postgresql+psycopg://user:pass@localhost:5432/certificates
# (and `pip install "psycopg[binary]"`)
DATABASE_URL=sqlite:///./certificates.db

# Where generated PDFs are written (STORAGE_DIR/<job_id>/<certificate_id>.pdf)
STORAGE_DIR=./storage

# Number of jobs processed concurrently by the in-process background worker
WORKER_THREADS=4

# Upper bound on recipients in a single request (POST /jobs, or one PATCH /jobs/{id}/recipients batch)
MAX_RECIPIENTS_PER_JOB=1000
# Upper bound on recipients in one job over its lifetime, including those added later with PATCH (409 beyond it)
MAX_TOTAL_RECIPIENTS_PER_JOB=5000

LOG_LEVEL=INFO

# ---------- Public verification (QR code) ----------
# The QR code on each certificate opens {PUBLIC_BASE_URL}/api/v1/verify/{code}/page.
# Use the address people scanning the certificate can reach, e.g. https://certificates.acme.example
# (printed into every PDF, so set it before generating).
PUBLIC_BASE_URL=http://127.0.0.1:8000
# Requests per minute per client IP on /api/v1/verify/* (brute-force protection). 0 disables.
VERIFY_RATE_LIMIT_PER_MINUTE=30

# ---------- Custom templates (logo / signature uploads) ----------
UPLOAD_DIR=./uploads
# 2 MB per image
MAX_UPLOAD_BYTES=2097152
# Images wider or taller than this are rejected; accepted ones are shrunk to fit IMAGE_DOWNSCALE_TO
MAX_IMAGE_DIMENSION=4000
IMAGE_DOWNSCALE_TO=1000

# ---------- Email (optional) ----------
# POST /api/v1/jobs/{job_id}/email returns 503 until SMTP_HOST and SMTP_FROM are set.
#
# Gmail: create an App Password (Google Account > Security > 2-Step Verification > App passwords)
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_STARTTLS=true
#   SMTP_USERNAME=you@gmail.com  SMTP_PASSWORD=<16-character app password>
# Outlook / Office 365: SMTP_HOST=smtp.office365.com  SMTP_PORT=587  SMTP_STARTTLS=true
# Mailtrap (safe testing inbox, nothing is really delivered): values from your Mailtrap inbox settings.
# Port 465 servers: SMTP_PORT=465  SMTP_USE_SSL=true  SMTP_STARTTLS=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_USE_SSL=false
SMTP_FROM=Acme Academy <you@gmail.com>
SMTP_TIMEOUT=30
